<mxCell id="ttl" value="Percurso do laboratório: do primeiro comando ao controlo de recursos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#4A4238;fontFamily=Helvetica;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="900" height="30" as="geometry"/></mxCell>

<mxCell id="s1" value="&lt;b&gt;1. Executar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;docker run hello-world&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7a6f63;&quot;&gt;Imagem e instância são coisas distintas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="628" width="182" height="96" as="geometry"/></mxCell>

<mxCell id="s2" value="&lt;b&gt;2. Isolar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;hostname · ps aux · ls /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7a6f63;&quot;&gt;Processos, ficheiros e nome próprios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="242" y="541" width="182" height="96" as="geometry"/></mxCell>

<mxCell id="s3" value="&lt;b&gt;3. Kernel partilhado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;uname -r dentro vs fora&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Linux: igual · macOS/Windows: difere&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7ECE5;strokeColor=#B5795C;strokeWidth=2;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="439" y="454" width="182" height="96" as="geometry"/></mxCell>

<mxCell id="s4" value="&lt;b&gt;4. Camadas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;docker history&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7a6f63;&quot;&gt;Uma imagem é uma pilha reutilizável&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="636" y="367" width="182" height="96" as="geometry"/></mxCell>

<mxCell id="s5" value="&lt;b&gt;5. Publicar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;-p 8080:80&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7a6f63;&quot;&gt;Pilha de rede própria, mapeada para fora&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="833" y="280" width="182" height="96" as="geometry"/></mxCell>

<mxCell id="s6" value="&lt;b&gt;6. Construir&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Dockerfile · docker build&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7a6f63;&quot;&gt;Produzir a própria imagem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="193" width="182" height="96" as="geometry"/></mxCell>

<mxCell id="s7" value="&lt;b&gt;7. Persistir e limitar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;-v volume · --memory · --cpus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#7a6f63;&quot;&gt;Estado que sobrevive e teto de recursos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1227" y="106" width="182" height="96" as="geometry"/></mxCell>

