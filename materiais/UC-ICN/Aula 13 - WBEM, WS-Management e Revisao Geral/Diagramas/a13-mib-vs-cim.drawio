6" value="Modelo CIM, objetos e associações" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="10" width="520" height="28" as="geometry"/></mxCell><mxCell id="c7" value="CIM_ComputerSystem" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="230" height="60" as="geometry"/></mxCell><mxCell id="c8" value="CIM_LogicalDisk" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="220" height="60" as="geometry"/></mxCell><mxCell id="c9" value="SystemDevice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;edgeStyle=none;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="CIM_NetworkPort" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="200" width="230" height="60" as="geometry"/></mxCell><mxCell id="c11" style="html=1;strokeColor=#8C7B6E;strokeWidth=2;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="130" as="sourcePoint"/><mxPoint x="685" y="200" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c12" value="As associações são classes que ligam objetos,&lt;br&gt;e permitem navegar do sistema para os seus discos e portas." style="text;htm