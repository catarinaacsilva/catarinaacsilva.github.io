<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="640" height="330" as="geometry"/></mxCell><mxCell id="c2" value="Servidor" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="14" width="640" height="28" as="geometry"/></mxCell><mxCell id="c3" value="Sistema operativo&lt;br&gt;e aplicações" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="90" as="geometry"/></mxCell><mxCell id="c4" value="BMC&lt;br&gt;controlador dedicado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="260" height="90" as="geometry"/></mxCell><mxCell id="c5" value="Alimentado e ligado à rede independentemente do sistema operativo." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="580" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Administrador&lt;br&gt;IPMI ou Redfish" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="300" height="90" as="geometry"/></mxCell><mxCell id="c7" value="rede de gestão" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="O BMC liga e desliga o servidor,&lt;br&gt;lê sensores e dá acesso à consola,&lt;br&gt;mesmo com o sistema operativo&lt;br&gt;inoperacional." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="380" height="140" as="geometry"/></mxCell><mxCell id="c9" value="Os BMC têm nomes comerciais como iDRAC, iLO e IMM. O IPMI usa UDP 623.&lt;br&gt;O Redfish é o sucessor, com API REST e JSON sobre HTTPS." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="380" width="1070" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>