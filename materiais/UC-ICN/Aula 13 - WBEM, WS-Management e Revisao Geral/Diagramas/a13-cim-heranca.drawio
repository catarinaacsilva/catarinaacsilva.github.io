<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="CIM_ManagedElement" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="320" height="56" as="geometry"/></mxCell><mxCell id="c2" value="CIM_ManagedSystemElement" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="94" width="320" height="56" as="geometry"/></mxCell><mxCell id="c3" value="CIM_LogicalElement" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="178" width="320" height="56" as="geometry"/></mxCell><mxCell id="c4" value="CIM_LogicalDevice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="262" width="320" height="56" as="geometry"/></mxCell><mxCell id="c5" value="CIM_LogicalDisk" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="346" width="320" height="56" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c2" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Cada classe herda as propriedades e os métodos da classe acima.&lt;br&gt;No topo estão os conceitos base do modelo core.&lt;br&gt;Em baixo ficam as classes específicas." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="10" width="640" height="120" as="geometry"/></mxCell><mxCell id="c11" value="A cadeia está simplificada. Na especificação do CIM existem&lt;br&gt;classes intermédias, e os fabricantes acrescentam extensões." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="640" height="100" as="geometry"/></mxCell><mxCell id="c12" value="Uma instância é identificada pela chave,&lt;br&gt;formada pelas propriedades marcadas como Key.&lt;br&gt;As classes têm também métodos, que se podem invocar." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="280" width="640" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>