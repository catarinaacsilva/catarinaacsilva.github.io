<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Consistência forte" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="520" height="28" as="geometry"/></mxCell><mxCell id="c2" value="escrita x=2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="70" width="130" height="50" as="geometry"/></mxCell><mxCell id="c3" value="replica A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="70" width="130" height="50" as="geometry"/></mxCell><mxCell id="c4" value="replica B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="170" width="130" height="50" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="propaga e espera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="A escrita só é confirmada depois de chegar às replicas.&lt;br&gt;Qualquer leitura devolve x=2, ao custo de latência." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="520" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Consistência eventual" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="10" width="520" height="28" as="geometry"/></mxCell><mxCell id="c9" value="escrita x=2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="130" height="50" as="geometry"/></mxCell><mxCell id="c10" value="replica A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="130" height="50" as="geometry"/></mxCell><mxCell id="c11" value="replica B&lt;br&gt;x=1 por agora" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EAE4;strokeColor=#C4775A;fontColor=#4A4238;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="170" width="130" height="50" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="propaga depois" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;dashed=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="A escrita é confirmada de imediato. Uma leitura em B pode&lt;br&gt;devolver x=1 até a replicação convergir." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="260" width="520" height="80" as="geometry"/></mxCell><mxCell id="c15" value="A consistência forte custa latência mesmo sem falhas. A eventual dá menor latência e mais disponibilidade." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="370" width="1080" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>