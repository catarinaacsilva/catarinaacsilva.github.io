<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c" value="Consistência&lt;br&gt;todas as leituras veem&lt;br&gt;o valor mais recente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;dashed=0;fontFamily=Helvetica;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="90" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="a" value="Disponibilidade&lt;br&gt;responde sempre,&lt;br&gt;mesmo que desatualizado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;dashed=0;fontFamily=Helvetica;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="p" value="Tolerância a partições&lt;br&gt;a rede pode falhar&lt;br&gt;— não é opcional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;dashed=0;fontFamily=Helvetica;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="710" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="r" value="Havendo partição, escolhe-se entre C e A." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7ECE5;strokeColor=#B5795C;fontColor=#4A4238;dashed=0;fontFamily=Helvetica;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="400" height="34" as="geometry"/></mxCell><mxCell id="pl" value="PACELC:  se há Partição → A ou C;   caso contrário (Else) → Latência ou Consistência" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF1EC;strokeColor=#7E8F7C;fontColor=#4A4238;dashed=0;fontFamily=Helvetica;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="130" y="250" width="780" height="40" as="geometry"/></mxCell><mxCell id="nt" value="Mesmo sem partições há um custo: garantir consistência entre réplicas exige esperar por confirmações." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="310" width="860" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>