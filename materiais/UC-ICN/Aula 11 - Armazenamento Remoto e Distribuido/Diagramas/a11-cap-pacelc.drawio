<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Consistência&lt;br&gt;todas as leituras veem&lt;br&gt;o valor mais recente" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="20" width="330" height="80" as="geometry"/></mxCell><mxCell id="c2" value="Disponibilidade&lt;br&gt;responde sempre,&lt;br&gt;mesmo com dados desatualizados" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="330" height="80" as="geometry"/></mxCell><mxCell id="c3" value="Tolerância a partições&lt;br&gt;a rede pode falhar,&lt;br&gt;por isso não é opcional" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="20" width="330" height="80" as="geometry"/></mxCell><mxCell id="c4" value="CAP. Havendo partição, escolhe-se entre consistência e disponibilidade." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EAE4;strokeColor=#C4775A;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="140" width="720" height="60" as="geometry"/></mxCell><mxCell id="c5" value="PACELC. Havendo partição escolhe-se entre A e C.&lt;br&gt;No caso contrário (else) escolhe-se entre latência e consistência." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="230" width="720" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Mesmo sem partições há um custo. Garantir consistência entre replicas exige esperar por confirmações.&lt;br&gt;É um compromisso de desenho, não uma limitação a ultrapassar." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="330" width="1080" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>