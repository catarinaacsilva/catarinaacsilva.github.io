="c13" value="A&lt;br&gt;99,9%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="100" height="50" as="geometry"/></mxCell><mxCell id="c14" value="B&lt;br&gt;99,9%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="100" height="50" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Em série: 0,999 × 0,999 = 99,8%&lt;br&gt;Qualquer falha derruba o conjunto." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="480" height="50" as="geometry"/></mxCell><mxCell id="c17" value="A 99,9%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="100" height="44" as="geometry"/></mxCell><mxCell id="c18" value="A 99,9%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="100" height="44" as="geometry"/></mxCell><mxCell id="c19" value="Em paralelo (redundância):&lt;br&gt;1 − (1 − 0,999)² = 99,9999%&lt;br&gt;Só falha se ambos falharem,&lt;br&gt;com falhas independentes." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="320" height="104" as="geometry"/></mxCell><mxCell id="c20" value="Cada nove adicional reduz o downtime permitido por um fator de 10, mas aumenta o custo e a complexidade.&lt;br&gt;Assume-se um ano de 8760 horas." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1040" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>