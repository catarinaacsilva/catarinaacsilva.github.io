<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="HPA&lt;br&gt;Horizontal Pod Autoscaler" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="320" height="80" as="geometry"/></mxCell><mxCell id="c2" value="Altera o número de Pods&lt;br&gt;de um Deployment.&lt;br&gt;Precisa do metrics-server." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="320" height="100" as="geometry"/></mxCell><mxCell id="c3" value="VPA&lt;br&gt;Vertical Pod Autoscaler" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="375" y="40" width="320" height="80" as="geometry"/></mxCell><mxCell id="c4" value="Ajusta requests e limits&lt;br&gt;de recursos de cada Pod." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="140" width="320" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Cluster Autoscaler" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="40" width="320" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Acrescenta ou remove nós&lt;br&gt;quando faltam recursos&lt;br&gt;para agendar Pods." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="140" width="320" height="100" as="geometry"/></mxCell><mxCell id="c7" value="HPA e VPA atuam sobre os Pods. O Cluster Autoscaler atua sobre os nós.&lt;br&gt;O Service distribui o tráfego pelos Pods prontos." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1040" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>