ed=1;" vertex="1" parent="1"><mxGeometry x="460" y="50" width="200" height="44" as="geometry"/></mxCell><mxCell id="c7" value="LV de origem. O snapshot só guarda a vista do instante." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="110" width="520" height="30" as="geometry"/></mxCell><mxCell id="c8" value="Depois de alterar B2" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="170" width="500" height="28" as="geometry"/></mxCell><mxCell id="c9" value="B1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="210" width="100" height="44" as="geometry"/></mxCell><mxCell id="c10" value="B2 novo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="210" width="100" height="44" as="geometry"/></mxCell><mxCell id="c11" value="B3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="210" width="100" height="44" as="geometry"/></mxCell><mxCell id="c12" value="B4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="210" width="100" height="44" as="geometry"/></mxCell><mxCell id="c13" value="B2 original" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="210" width="160" height="44" as="geometry"/></mxCell><mxCell id="c14" value="Área COW do snapshot" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="170" width="300" height="28" as="geometry"/></mxCell><mxCell id="c15" value="Antes de B2 ser sobrescrito, o bloco original é copiado para a área do snapshot.&lt;br&gt;O snapshot lê B1, B3 e B4 do LV e B2 da sua área." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="270" width="780" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Só os blocos alterados ocupam espaço. Se a área COW de um snapshot clássico encher, o snapshot fica inválido." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="1080" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>