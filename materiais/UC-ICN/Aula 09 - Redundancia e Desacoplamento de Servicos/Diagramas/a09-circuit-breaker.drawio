<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Fechado&lt;br&gt;os pedidos passam e as&lt;br&gt;falhas são contadas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="100" as="geometry"/></mxCell><mxCell id="c2" value="Aberto&lt;br&gt;os pedidos falham logo,&lt;br&gt;sem chamar o serviço" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EAE4;strokeColor=#C4775A;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="260" height="100" as="geometry"/></mxCell><mxCell id="c3" value="Semi-aberto&lt;br&gt;alguns pedidos de teste&lt;br&gt;passam para o serviço" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="260" height="100" as="geometry"/></mxCell><mxCell id="c4" value="falhas acima do limiar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;edgeStyle=none;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;edgeStyle=none;exitX=0.25;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="testes com sucesso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;edgeStyle=none;exitX=0.1;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c3" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C7B6E;strokeWidth=1.5;fontColor=#4A4238;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FAF8F5;endArrow=classic;edgeStyle=none;exitX=1;exitY=0.25;entryX=0.75;entryY=1;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="Quando o tempo de espera termina,&lt;br&gt;o estado passa de aberto a semi-aberto.&lt;br&gt;Se os testes falham, volta a aberto.&lt;br&gt;Se têm sucesso, volta a fechado." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="60" width="290" height="160" as="geometry"/></mxCell><mxCell id="c9" value="Protege o serviço em dificuldades e poupa recursos ao cliente." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="520" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>