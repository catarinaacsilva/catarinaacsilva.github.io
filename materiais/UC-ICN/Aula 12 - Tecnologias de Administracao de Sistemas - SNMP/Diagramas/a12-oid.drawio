 ficheiros MIB traduzem estes números em nomes legíveis para as ferramentas." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="200" width="1070" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>