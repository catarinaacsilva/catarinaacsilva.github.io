<mxfile host="app.diagrams.net"><diagram name="Page-1" id="d1"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="SNMPv1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="340" height="50" as="geometry"/></mxCell><mxCell id="c2" value="segurança por community&lt;br&gt;texto simples&lt;br&gt;sem GETBULK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EAE4;strokeColor=#C4775A;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="70" width="340" height="110" as="geometry"/></mxCell><mxCell id="c3" value="SNMPv2c" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="10" width="340" height="50" as="geometry"/></mxCell><mxCell id="c4" value="community string em texto simples&lt;br&gt;com GETBULK e INFORM&lt;br&gt;mais desempenho" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="70" width="340" height="110" as="geometry"/></mxCell><mxCell id="c5" value="SNMPv3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9C5B2;strokeColor=#BFAFA6;fontColor=#4A4238;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="10" width="340" height="50" as="geometry"/></mxCell><mxCell id="c6" value="utilizadores, autenticação,&lt;br&gt;cifra e controlo de acesso&lt;br&gt;USM e VACM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF0EA;strokeColor=#7A9078;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="70" width="340" height="110" as="geometry"/></mxCell><mxCell id="c7" value="A community string funciona como palavra-passe mas viaja sem proteção na rede.&lt;br&gt;O SNMPv3 corrige esta fragilidade com autenticação, integridade, cifra e proteção contra repetição.&lt;br&gt;O SNMPv2c continua muito usado em ambientes legados, mas o SNMPv3 é a escolha recomendada&lt;br&gt;sempre que a segurança da rede de gestão conta." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#4A4238;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="210" width="1070" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>